---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { clubs, type Club } from "../../data/clubs";

export function getStaticPaths() {
  return clubs.map((club) => ({ params: { slug: club.slug }, props: { club } }));
}

interface Props {
  club: Club;
}

const { club } = Astro.props;

const linkList = [
  club.links.website && { label: "官方網站", href: club.links.website },
  club.links.facebook && { label: "Facebook", href: club.links.facebook },
  club.links.instagram && { label: "Instagram", href: club.links.instagram },
  club.links.x && { label: "X (Twitter)", href: club.links.x },
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<Layout title={`${club.name}｜交大宅文化連合`} description={club.description}>
  <div class="relative mx-auto w-full max-w-xl">
    <div class="relative aspect-[4/3] w-full overflow-hidden bg-surface">
      <Image
        src={club.logo}
        alt=""
        aria-hidden="true"
        width={800}
        height={600}
        class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl brightness-50"
      />
      <Image
        src={club.logo}
        alt={`${club.name} 社徽`}
        width={800}
        height={800}
        class="relative h-full w-full object-contain"
      />
    </div>
    <a
      href="/"
      class="absolute left-4 top-4 rounded-full bg-canvas/70 px-3 py-1.5 text-xs font-bold backdrop-blur-sm transition-colors hover:bg-canvas/90"
    >
      ← 回首頁
    </a>
  </div>

  <main class="mx-auto flex w-full max-w-xl flex-col items-center px-5 pb-16 pt-8 sm:pt-10">
    <div class="flex items-center gap-3">
      {
        club.mascot && (
          <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full border border-border">
            <Image
              src={club.mascot}
              alt={`${club.name} 吉祥物`}
              width={96}
              height={96}
              class="h-full w-full object-cover"
            />
          </div>
        )
      }
      <h1 class="text-2xl font-black">{club.name}</h1>
    </div>
    <p class="mt-1 text-sm font-bold" style={{ color: club.color }}>
      {club.tagline}
    </p>
    <p class="mt-4 text-center text-sm leading-relaxed text-ink-muted">{club.description}</p>

    {
      club.links.joinForm && (
        <a
          href={club.links.joinForm}
          target="_blank"
          rel="noreferrer"
          class="mt-6 flex w-full items-center justify-center rounded-xl px-5 py-3.5 text-sm font-black text-canvas transition-opacity hover:opacity-90"
          style={{ backgroundColor: club.color }}
        >
          立即入社 →
        </a>
      )
    }

    <div class="mt-6 w-full divide-y divide-border">
      <div class="flex items-center gap-3 py-3">
        <span class="w-14 shrink-0 text-sm font-bold">社辦</span>
        <span class="text-sm text-ink-muted">{club.room}</span>
      </div>
      {
        club.links.email && (
          <div class="flex items-center gap-3 py-3">
            <span class="w-14 shrink-0 text-sm font-bold">Email</span>
            <a href={`mailto:${club.links.email}`} class="text-sm text-ink-muted hover:underline">
              {club.links.email}
            </a>
          </div>
        )
      }
    </div>

    <div class="mt-10 flex w-full flex-col gap-3">
      {
        linkList.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-center rounded-xl border border-border bg-surface px-5 py-3 text-sm font-bold transition-colors hover:bg-surface-hover"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </main>
</Layout>
