---
import Layout from "../layouts/Layout.astro";
import ClubCard from "../components/ClubCard.astro";
import OrientationBanner from "../components/OrientationBanner.astro";
import { clubs } from "../data/clubs";
---

<Layout title="交大宅文化連合">
  <main class="mx-auto flex w-full max-w-5xl flex-col items-center px-5 py-10 sm:py-12">
    <div class="w-full">
      <OrientationBanner />
    </div>

    <h1 class="text-center text-2xl font-black tracking-tight sm:text-3xl">交大宅文化連合</h1>
    <p class="mt-3 max-w-2xl text-center text-sm leading-relaxed text-ink-muted sm:text-base">
      「交大宅文化連合」是由交大校內各個宅系社團所組成的交流與互助團體，透過社團間的合作，促進不同領域同好的交流與互動。
    </p>

    <a
      href="/quiz/"
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-7 py-3.5 text-base font-black text-canvas shadow-lg transition-transform hover:scale-[1.03]"
    >
      還不知道要選哪個社團？來做個小測驗
      <span aria-hidden="true">→</span>
    </a>

    <div class="mt-10 grid w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {clubs.map((club) => <ClubCard club={club} />)}
    </div>
  </main>
</Layout>
