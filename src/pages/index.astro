---
import Layout from "../layouts/Layout.astro";
import ClubCard from "../components/ClubCard.astro";
import OrientationBanner from "../components/OrientationBanner.astro";
import { clubs } from "../data/clubs";
---

<Layout title="交大宅文化連合">
  <main class="mx-auto flex w-full max-w-5xl flex-col items-center px-5 py-16 sm:py-20">
    <h1 class="text-center text-2xl font-black tracking-tight sm:text-3xl">交大宅文化連合</h1>
    <p class="mt-4 max-w-2xl text-center text-sm leading-relaxed text-ink-muted sm:text-base">
      交大「宅系社團」是由一群對特定興趣抱有熱情的人所組成的各類社團。各社團多以日本
      ACGN 等非主流次文化為主，但並不侷限於特定國家、文化或領域，皆有各自不同的發展方向，而共同點便是對所喜愛的事物抱有熱情。「交大宅文化連合」是由交大校內各個宅系社團所組成的交流與互助團體，透過社團間的合作，促進不同領域同好的交流與互動。
    </p>

    <a
      href="/quiz/"
      class="mt-8 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-5 py-2.5 text-sm font-bold transition-colors hover:bg-surface-hover"
    >
      還不知道要選哪個社團？來做個小測驗
      <span aria-hidden="true">→</span>
    </a>

    <div class="mt-16 w-full">
      <OrientationBanner />
    </div>

    <div class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {clubs.map((club) => <ClubCard club={club} />)}
    </div>
  </main>
</Layout>
